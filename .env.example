# Copy to .env and fill in. Never commit .env.

# Hearing
DEEPGRAM_API_KEY=          # default listener (world languages, Hindi, English)
SARVAM_API_KEY=            # Indian languages: hearing, identification, voice
ASSEMBLYAI_API_KEY=        # optional backup listener

# Language identification (Groq Whisper); the quickstart agent also uses it to reply
GROQ_API_KEY=

# Shared secret between the Voxie server and your agent (optional locally)
STREAMCORE_AGENT_API_KEY=

# Voice router
VOXIE_VOICE_GENDER=female  # female | male (also picks Sarvam's speaker)
VOXIE_ENGLISH_VOICE=af_heart   # any Kokoro voice; hm_omega = Indian-accented English
