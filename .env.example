# Copy to .env and fill in. Never commit .env.

# Hearing
DEEPGRAM_API_KEY=          # default listener (world languages, Hindi, English)
SARVAM_API_KEY=            # Indian languages: hearing, identification, voice
ASSEMBLYAI_API_KEY=        # optional backup listener

# Language identification (Groq Whisper); the quickstart agent also uses it to reply
GROQ_API_KEY=

# Shared secret between the Voxie server and your agent (optional locally)
STREAMCORE_AGENT_API_KEY=

# Voice router
VOXIE_VOICE=female  # female | male | female-2 | male-2: one voice across every language (voice-router/README.md)
VOXIE_ENGLISH_VOICE=   # optional: any Kokoro voice for English instead of the persona's; hm_omega = Indian-accented English
# VOXIE_HF_CACHE=/path/to/huggingface   # share an existing Hugging Face cache (default: a Docker volume)

# Phone calls through Twilio Media Streams (README → Phone calls)
# TWILIO_AUTH_TOKEN=                  # turns on /twilio/media; only Twilio-signed streams are accepted
# VOXIE_TWILIO_STREAM_URL=wss://<public host>/twilio/media   # only behind a proxy that rewrites Host
